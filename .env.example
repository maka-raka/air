# AIR (copy to .env; .env is git-ignored; chmod 600 .env)
# Read docs/engineering/security-hardening.md first: accounts, token
# permissions and repository settings are part of AIR's security.

# <owner>/<repo>, ideally a PRIVATE repository
AIR_REPOSITORY=

# --- Accounts: set the same values in EVERY AIR process -------------------
# Dedicated account the poller runs as (writes replies and state labels).
AIR_OPERATOR_LOGIN=
# Dedicated agent account (npx air ...).
AIR_AGENT_LOGIN=
# Dedicated deploy account (npx air-deploy ...). Leave empty if you do not
# report deployments.
# AIR_DEPLOY_LOGIN=
# People whose /air comments count as approvals, comma-separated.
AIR_APPROVER_LOGINS=

# --- Poller (npm run local:run) --------------------------------------------
# Fine-grained token of AIR_OPERATOR_LOGIN for this one repository:
#   Issues RW · Pull requests R · Commit statuses R · Checks R · Metadata R
AIR_GITHUB_TOKEN=
# AIR_POLL_INTERVAL_MS=20000
# AIR_STATE_DIR=.air
# AIR_LEASE_MS=60000
# Test repositories only: lets the operator account also approve.
# AIR_ALLOW_OPERATOR_APPROVER=true

# --- Agent CLI (npx air ...) ------------------------------------------------
# Token of AIR_AGENT_LOGIN. No Workflows or Administration permission.
# AIR_AGENT_TOKEN=
# AIR_RUN_TTL_MS=7200000

# --- Deployment workflow (npx air-deploy <stage|prod> <issue> <sha>) -------
# Token of AIR_DEPLOY_LOGIN, stored as an environment secret in CI.
# AIR_DEPLOY_TOKEN=
# AIR_ENVIRONMENT_STAGE=stage
# AIR_ENVIRONMENT_PROD=prod
