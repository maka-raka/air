# AIR local runtime (copy to .env; .env is git-ignored)
# Fine-grained token for ONE test repository:
#   Issues: Read and write · Metadata: Read
AIR_GITHUB_TOKEN=
# <owner>/<repo>
AIR_REPOSITORY=
# Optional
# AIR_POLL_INTERVAL_MS=20000
# AIR_STATE_DIR=.air
# AIR_LEASE_MS=60000

# Agent CLI (npx air ...). Use a SEPARATE GitHub account with write access.
# AIR_AGENT_TOKEN=
# AIR_AGENT_LOGIN=
# Optional: also set AIR_AGENT_LOGIN for `npm run local:run` so the agent's
# /air comments are never accepted as Human commands.
# AIR_RUN_TTL_MS=7200000

# Deployment workflow (npx air-deploy <stage|prod> <issue> <sha>).
# A THIRD account, different from the agent.
# AIR_DEPLOY_TOKEN=
# AIR_DEPLOY_LOGIN=
# AIR_ENVIRONMENT_STAGE=stage
# AIR_ENVIRONMENT_PROD=prod
