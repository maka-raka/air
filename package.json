{
  "name": "@air/delivery-core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "AIR delivery runtime: comment-command poller, agent CLI and deploy reporter for GitHub issues.",
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist/src/**/*.js",
    "!dist/src/**/*.test.js",
    "templates/",
    ".env.example"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "rm -rf dist && tsc",
    "test": "npm run build && node --test 'dist/src/**/*.test.js'",
    "code:check": "eslint src tools --max-warnings 0",
    "format:check": "prettier --check 'src/**/*.ts' 'tools/**/*.mjs' eslint.config.mjs",
    "quality:check": "npm run policy:check && npm run code:check && npm run code:test && npm run format:check && npm run typecheck && npm test && npm run architecture:check && npm run fitness:test",
    "code:test": "node --test tools/code/*.test.mjs",
    "format:write": "prettier --write 'src/**/*.ts' 'tools/**/*.mjs' eslint.config.mjs",
    "architecture:check": "node tools/architecture/check.mjs && node tools/architecture/check.test.mjs && depcruise --config .dependency-cruiser.cjs --ts-config tsconfig.json --ts-pre-compilation-deps src",
    "policy:check": "node tools/policy/check.mjs && node tools/policy/check.test.mjs",
    "fitness:test": "node --test tools/fitness/check-evidence.test.mjs",
    "local:run": "npm run build && node --env-file-if-exists=.env dist/src/delivery/composition/local.js"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "@types/node": "^26.6.6",
    "eslint": "^10.14.0",
    "@typescript-eslint/parser": "^8.46.0",
    "prettier": "^3.6.2",
    "dependency-cruiser": "^18.0.0",
    "fast-check": "^4.0.0"
  },
  "dependencies": {
    "http-status-codes": "^2.3.0"
  },
  "bin": {
    "air": "dist/src/delivery/composition/agent-cli.js",
    "air-deploy": "dist/src/delivery/composition/deploy-cli.js",
    "air-local": "dist/src/delivery/composition/local.js"
  }
}
