{
  "allowManagedHooksOnly": true,
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/usr/local/bin/air-stop-hook",
            "timeout": 120
          }
        ]
      }
    ]
  },
  "allowManagedPermissionRulesOnly": true,
  "allowManagedMcpServersOnly": true,
  "allowedMcpServers": [],
  "enableAllProjectMcpServers": false,
  "disableBypassPermissionsMode": "disable",
  "permissions": {
    "deny": [
      "Bash(gh issue view:*)",
      "Bash(gh api:*comments*)",
      "Bash(gh pr merge:*)",
      "Bash(gh pr review:*)",
      "Bash(gh release:*)",
      "Bash(gh workflow:*)",
      "Bash(gh secret:*)",
      "Bash(gh label:*)",
      "Bash(gh issue edit:*)",
      "Bash(gh issue close:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push origin main:*)",
      "Bash(env:*)",
      "Bash(printenv:*)",
      "Read(/proc/*/environ)",
      "Edit(.github/**)",
      "Edit(.claude/**)",
      "Edit(CLAUDE.md)",
      "Edit(AGENTS.md)",
      "Edit(.mcp.json)",
      "Edit(CODEOWNERS)",
      "Edit(.env*)"
    ]
  }
}
