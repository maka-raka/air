# Agent containers ONLY (secret).
# cp docker/env/agent.env.example .env.air.agent && chmod 600 .env.air.agent

# Token of AIR_AGENT_LOGIN. No Workflows or Administration permission.
AIR_AGENT_TOKEN=
# Signs the agent's records and state anchors.
AIR_AGENT_SIGNING_KEY=
# Claude Code in the container.
ANTHROPIC_API_KEY=

# Optional: replaces the default "Take issue #<n> …" prompt.
# AIR_AGENT_PROMPT=

# interactive (default): Claude Code in tmux, for a person to attach to.
# headless: `claude -p` without prompts, for runs nobody watches; after
# the session the run ends with `air gate` or `air block`, never working.
# AIR_AGENT_MODE=headless
# Headless only: the most model turns one session may take.
# AIR_AGENT_MAX_TURNS=200
# Headless only: the session is stopped after this long (90m, 2h, 1d), and
# the run is closed as usual.
# AIR_AGENT_MAX_RUNTIME=2h
# How many times the Stop hook sends the agent back to a refused gate.
# AIR_STOP_HOOK_MAX=3
