# Shared by the poller and every agent container: NOT secret.
# cp docker/env/air.env.example .env.air && chmod 600 .env.air
# Never put a token or a signing key here: both containers read this file.

# <owner>/<repo>, ideally a PRIVATE repository
AIR_REPOSITORY=
# standard (default) or lite: lite is for plans without branch rules, such
# as a private repository on GitHub Free (docs/architecture/adr/0016-lite-mode.md).
# AIR_MODE=standard

AIR_OPERATOR_LOGIN=
AIR_AGENT_LOGIN=
# AIR_DEPLOY_LOGIN=
AIR_APPROVER_LOGINS=

# npx air keygen [agent|operator|deployer]: public halves only
AIR_AGENT_PUBLIC_KEY=
AIR_OPERATOR_PUBLIC_KEY=
# AIR_DEPLOY_PUBLIC_KEY=

# AIR_STATE_ANCHORS=require
# AIR_RUN_TTL_MS=7200000
