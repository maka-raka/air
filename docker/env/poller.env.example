# Poller container ONLY (secret).
# cp docker/env/poller.env.example .env.air.poller && chmod 600 .env.air.poller

# Fine-grained token of AIR_OPERATOR_LOGIN for this one repository:
#   Issues RW · Pull requests R · Commit statuses R · Checks R · Metadata R
AIR_GITHUB_TOKEN=
# Signs the state the poller sets.
AIR_OPERATOR_SIGNING_KEY=

# AIR_POLL_INTERVAL_MS=20000
# AIR_LEASE_MS=60000

# Request an agent run after an approver's command makes one of these phases
# ready (ADR-0011). Empty: agents are started by hand. Needs air-launcher.
# AIR_AGENT_LAUNCH_PHASES=requirements,design,build,review
