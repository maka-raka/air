# Console container ONLY (ADR-0012). It reads; it never writes.
# cp docker/env/ui.env.example .env.air.ui && chmod 600 .env.air.ui

# Fine-grained token of a PERSON or a reader account (never air-bot,
# air-agent or the deployer) for this one repository:
#   Issues: Read · Metadata: Read
AIR_UI_TOKEN=

# The repository, logins and public keys (AIR_OPERATOR_PUBLIC_KEY is
# required here) come from .env.air.

# AIR_UI_REFRESH_MS=30000
